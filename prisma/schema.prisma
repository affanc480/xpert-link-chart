generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AccountType {
  CUSTOMER
  VENDOR
  PARTNER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ReportFormat {
  PDF
  XLSX
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  phone     String?
  company   String?
  businessType String?
  country   String?
  avatar    String?

  role   Role       @default(USER)
  status UserStatus @default(ACTIVE)

  emailVerified      Boolean   @default(false)
  verificationOTP    String?
  otpExpiry          DateTime?
  resetPasswordOTP   String?
  resetOTPExpiry     DateTime?

  activityLogs        ActivityLog[]
  accounts            Account[]
  inventoryItems      Inventory[]
  reports             Report[]
  chartMainAccounts   ChartOfAccountMain[]
  chartGeneralAccounts ChartOfAccountGeneral[]
  accountEntries      AccountEntry[]
  setup               Setup?
  settings            Settings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  description String?
  ip          String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Account {
  id           String        @id @default(cuid())
  accountName  String
  accountType  AccountType   @default(CUSTOMER)
  contactEmail String?
  phone        String?
  address      String?
  status       AccountStatus @default(ACTIVE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries AccountEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Inventory {
  id        String          @id @default(cuid())
  sku       String
  name      String
  quantity  Int             @default(0)
  warehouse String?
  unitPrice Float?          @default(0)
  status    InventoryStatus @default(IN_STOCK)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sku])
  @@index([userId])
}

model Report {
  id        String       @id @default(cuid())
  title     String
  type      String
  format    ReportFormat @default(PDF)
  data      Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChartOfAccountMain {
  id     String  @id @default(cuid())
  code   String
  title  String
  nature String?
  isActive Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generalAccounts ChartOfAccountGeneral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
}

model ChartOfAccountGeneral {
  id    String  @id @default(cuid())
  code  String
  title String
  isActive Boolean @default(true)

  mainAccountId String
  mainAccount   ChartOfAccountMain @relation(fields: [mainAccountId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries AccountEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
  @@index([mainAccountId])
}

model AccountEntry {
  id          String   @id @default(cuid())
  description String?
  debit       Float    @default(0)
  credit      Float    @default(0)
  entryDate   DateTime @default(now())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  generalAccountId String?
  generalAccount   ChartOfAccountGeneral? @relation(fields: [generalAccountId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Setup {
  id              String  @id @default(cuid())
  companyName     String?
  registrationNo  String?
  businessEmail   String?
  phone           String?
  address         String?
  notifications   Boolean @default(true)
  twoFactor       Boolean @default(false)
  autoDarkMode    Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                  String  @id @default(cuid())
  emailNotifications  Boolean @default(true)
  systemNotifications Boolean @default(true)
  theme               String  @default("system")
  language            String  @default("English")
  timezone            String  @default("UTC")
  privacyAnalytics    Boolean @default(true)
  twoFactorEnabled    Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  createdAt DateTime @default(now())
}
